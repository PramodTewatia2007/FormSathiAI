# FormSathiAI Environment Configuration
# The demo runs 100% offline deterministically without any API key.

# Optional: Set an external LLM key if you wish to test live generation mode
OPENAI_API_KEY=
GEMINI_API_KEY=
LLM_PROVIDER=offline

# Tesseract OCR Executable Path (Windows default)
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# Port and Host
HOST=127.0.0.1
PORT=8000
